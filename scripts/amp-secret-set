#!/usr/bin/env bash
set -euo pipefail

readonly amp_project="${AMP_PROJECT:-jenicola/nahcloud}"
name="${1:-}"
source_file="${2:--}"

case "$name" in
  FORGE_API_TOKEN|DIGITALOCEAN_ACCESS_TOKEN) ;;
  *)
    printf 'Usage: %s FORGE_API_TOKEN|DIGITALOCEAN_ACCESS_TOKEN [secret-file|-]\n' "$0" >&2
    exit 2
    ;;
esac

command -v amp >/dev/null 2>&1 || {
  printf '%s\n' 'amp CLI is required.' >&2
  exit 1
}

if [ "$source_file" = '-' ] && [ -t 0 ]; then
  read -r -s -p "$name: " secret_value
  printf '\n' >&2
  if [ -z "$secret_value" ]; then
    printf '%s\n' 'Secret value cannot be empty.' >&2
    exit 1
  fi
  printf %s "$secret_value" | amp secrets set "$name" \
    --project "$amp_project" --secret --data-file -
  unset secret_value
elif [ "$source_file" = '-' ]; then
  amp secrets set "$name" --project "$amp_project" --secret --data-file -
else
  if [ ! -f "$source_file" ] || [ ! -r "$source_file" ]; then
    printf 'Secret file is not readable: %s\n' "$source_file" >&2
    exit 1
  fi
  amp secrets set "$name" --project "$amp_project" --secret --data-file "$source_file"
fi
